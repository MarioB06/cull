{
  "expo": {
    "name": "Cull",
    "slug": "cull",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cull",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15110d",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mariobozic.cull",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Cull braucht Zugriff auf deine Fotos, um sie hier durchzugehen und aufzuräumen. Es verlässt nichts dein Gerät.",
        "NSPhotoLibraryAddUsageDescription": "Cull braucht Zugriff auf deine Fotomediathek, um markierte Fotos zu entfernen. Es verlässt nichts dein Gerät.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mariobozic.cull",
      "adaptiveIcon": {
        "backgroundColor": "#15110d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Cull braucht Zugriff auf deine Fotos, um sie hier durchzugehen und aufzuräumen. Es verlässt nichts dein Gerät.",
          "savePhotosPermission": "Cull braucht Zugriff auf deine Fotomediathek, um markierte Fotos zu entfernen.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-video",
      "expo-localization"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "dd2a6523-1a03-46cb-9bbf-3beb94071754"
      }
    }
  }
}
